rules_version = '2';

// Regras do Diagnóstico 360° de TI (SAN Conecta).
//
// Modelo:
//   staff/{email}                         administradores da SAN (todas as empresas)
//   empresas/{empresaId}                  dados da empresa cliente
//   empresas/{empresaId}/itens/{itemId}   os 31 itens (TI e Gestão do Negócio) do diagnóstico ("1.1" a "5.3")
//   membros/{empresaId}__{email}          quem acessa cada empresa (sempre com perfil de leitura)
//
// Princípios:
//   - Tudo exige login com e-mail VERIFICADO. Criar conta sozinho não libera nenhum dado.
//   - Cliente só enxerga a empresa em que o e-mail dele consta em "membros".
//   - Só administradores SAN criam empresas, liberam usuários, preenchem os itens e alteram a equipe SAN.
//   - Cliente tem apenas leitura da própria empresa. Não existe perfil de edição para cliente.
//   - Empresas só são apagadas depois de arquivadas (e os itens delas junto); nunca por cliente.
//   - O primeiro administrador SAN é criado à mão no console (staff/<email>), conforme docs/DIAGNOSTICO.md.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email != null;
    }

    function me() {
      return request.auth.token.email.lower();
    }

    function isStaff() {
      return signedIn()
        && exists(/databases/$(database)/documents/staff/$(me()));
    }

    function isMember(emp) {
      return signedIn()
        && exists(/databases/$(database)/documents/membros/$(emp + '__' + me()));
    }

    function shortStr(v, max) {
      return v is string && v.size() <= max;
    }

    // Respostas por pergunta (v1.6): chaves fixas q01..q40, texto até 2000. Notas de maturidade por bloco: chaves b1..b10, inteiro 0 a 5.
    function respOk(r) {
      return r is map
        && r.keys().hasOnly(['q01','q02','q03','q04','q05','q06','q07','q08','q09','q10','q11','q12','q13','q14','q15','q16','q17','q18','q19','q20','q21','q22','q23','q24','q25','q26','q27','q28','q29','q30','q31','q32','q33','q34','q35','q36','q37','q38','q39','q40'])
        && (!('q01' in r) || shortStr(r['q01'], 2000))
        && (!('q02' in r) || shortStr(r['q02'], 2000))
        && (!('q03' in r) || shortStr(r['q03'], 2000))
        && (!('q04' in r) || shortStr(r['q04'], 2000))
        && (!('q05' in r) || shortStr(r['q05'], 2000))
        && (!('q06' in r) || shortStr(r['q06'], 2000))
        && (!('q07' in r) || shortStr(r['q07'], 2000))
        && (!('q08' in r) || shortStr(r['q08'], 2000))
        && (!('q09' in r) || shortStr(r['q09'], 2000))
        && (!('q10' in r) || shortStr(r['q10'], 2000))
        && (!('q11' in r) || shortStr(r['q11'], 2000))
        && (!('q12' in r) || shortStr(r['q12'], 2000))
        && (!('q13' in r) || shortStr(r['q13'], 2000))
        && (!('q14' in r) || shortStr(r['q14'], 2000))
        && (!('q15' in r) || shortStr(r['q15'], 2000))
        && (!('q16' in r) || shortStr(r['q16'], 2000))
        && (!('q17' in r) || shortStr(r['q17'], 2000))
        && (!('q18' in r) || shortStr(r['q18'], 2000))
        && (!('q19' in r) || shortStr(r['q19'], 2000))
        && (!('q20' in r) || shortStr(r['q20'], 2000))
        && (!('q21' in r) || shortStr(r['q21'], 2000))
        && (!('q22' in r) || shortStr(r['q22'], 2000))
        && (!('q23' in r) || shortStr(r['q23'], 2000))
        && (!('q24' in r) || shortStr(r['q24'], 2000))
        && (!('q25' in r) || shortStr(r['q25'], 2000))
        && (!('q26' in r) || shortStr(r['q26'], 2000))
        && (!('q27' in r) || shortStr(r['q27'], 2000))
        && (!('q28' in r) || shortStr(r['q28'], 2000))
        && (!('q29' in r) || shortStr(r['q29'], 2000))
        && (!('q30' in r) || shortStr(r['q30'], 2000))
        && (!('q31' in r) || shortStr(r['q31'], 2000))
        && (!('q32' in r) || shortStr(r['q32'], 2000))
        && (!('q33' in r) || shortStr(r['q33'], 2000))
        && (!('q34' in r) || shortStr(r['q34'], 2000))
        && (!('q35' in r) || shortStr(r['q35'], 2000))
        && (!('q36' in r) || shortStr(r['q36'], 2000))
        && (!('q37' in r) || shortStr(r['q37'], 2000))
        && (!('q38' in r) || shortStr(r['q38'], 2000))
        && (!('q39' in r) || shortStr(r['q39'], 2000))
        && (!('q40' in r) || shortStr(r['q40'], 2000));
    }
    function notaOk(n, k) {
      return !(k in n) || (n[k] is int && n[k] >= 0 && n[k] <= 5);
    }
    function notasOk(n) {
      return n is map
        && n.keys().hasOnly(['b1','b2','b3','b4','b5','b6','b7','b8','b9','b10'])
        && notaOk(n, 'b1')
        && notaOk(n, 'b2')
        && notaOk(n, 'b3')
        && notaOk(n, 'b4')
        && notaOk(n, 'b5')
        && notaOk(n, 'b6')
        && notaOk(n, 'b7')
        && notaOk(n, 'b8')
        && notaOk(n, 'b9')
        && notaOk(n, 'b10');
    }

    // Equipe SAN
    match /staff/{email} {
      allow read: if signedIn() && (isStaff() || email == me());
      allow create: if isStaff()
        && email == email.lower()
        && request.resource.data.keys().hasOnly(['email', 'criadoEm', 'criadoPor'])
        && request.resource.data.email == email
        && request.resource.data.criadoPor == me()
        && request.resource.data.criadoEm == request.time;
      allow delete: if isStaff() && email != me();
      allow update: if false;
    }

    // Empresas clientes
    match /empresas/{emp} {
      allow read: if isStaff() || isMember(emp);

      allow create: if isStaff()
        && request.resource.data.keys().hasOnly(['nome', 'cnpj', 'responsavel', 'inicio', 'prazo', 'arquivada', 'criadoEm', 'criadoPor'])
        && request.resource.data.keys().hasAll(['nome', 'criadoEm', 'criadoPor'])
        && shortStr(request.resource.data.nome, 120) && request.resource.data.nome.size() >= 2
        && shortStr(request.resource.data.cnpj, 20)
        && shortStr(request.resource.data.responsavel, 120)
        && shortStr(request.resource.data.inicio, 10)
        && shortStr(request.resource.data.prazo, 10)
        && request.resource.data.arquivada is bool
        && request.resource.data.criadoEm == request.time
        && request.resource.data.criadoPor == me();

      allow update: if isStaff()
        && request.resource.data.keys().hasOnly(['nome', 'cnpj', 'responsavel', 'inicio', 'prazo', 'arquivada', 'criadoEm', 'criadoPor', 'atualizadoEm', 'atualizadoPor'])
        && shortStr(request.resource.data.nome, 120) && request.resource.data.nome.size() >= 2
        && shortStr(request.resource.data.cnpj, 20)
        && shortStr(request.resource.data.responsavel, 120)
        && shortStr(request.resource.data.inicio, 10)
        && shortStr(request.resource.data.prazo, 10)
        && request.resource.data.arquivada is bool
        && request.resource.data.criadoEm == resource.data.criadoEm
        && request.resource.data.criadoPor == resource.data.criadoPor
        && request.resource.data.atualizadoEm == request.time
        && request.resource.data.atualizadoPor == me();

      // Só se apaga empresa que já foi arquivada (o primeiro passo é sempre arquivar).
      allow delete: if isStaff() && resource.data.arquivada == true;

      // Itens do diagnóstico
      match /itens/{item} {
        allow read: if isStaff() || isMember(emp);

        allow create, update: if isStaff()
          && item.matches('^([1-5]\\.[1-5]|([6-9]|10)\\.[1-3])$')
          && request.resource.data.keys().hasOnly(['status', 'risk', 'owner', 'due', 'findings', 'evidence', 'reco', 'updatedAt', 'updatedBy', 'maturity', 'evidStatus', 'respostas', 'notas'])
          && request.resource.data.keys().hasAll(['status', 'risk', 'owner', 'due', 'findings', 'evidence', 'reco', 'updatedAt', 'updatedBy'])
          && request.resource.data.status in ['nao_iniciado', 'coleta', 'analise', 'concluido']
          && request.resource.data.risk in ['sem', 'baixo', 'medio', 'alto', 'critico']
          && shortStr(request.resource.data.owner, 80)
          && shortStr(request.resource.data.due, 10)
          && shortStr(request.resource.data.findings, 4000)
          && shortStr(request.resource.data.evidence, 300)
          && shortStr(request.resource.data.reco, 4000)
          // Campos novos (v1.1), opcionais: maturidade 0 a 5 (ou null) e situação da evidência.
          && (!('maturity' in request.resource.data) || request.resource.data.maturity == null
              || (request.resource.data.maturity is int && request.resource.data.maturity >= 0 && request.resource.data.maturity <= 5))
          && (!('evidStatus' in request.resource.data)
              || request.resource.data.evidStatus in ['nao_solicitada', 'solicitada', 'parcial', 'recebida', 'nao_recebida', 'nao_aplica'])
          && (!('respostas' in request.resource.data) || respOk(request.resource.data.respostas))
          && (!('notas' in request.resource.data) || notasOk(request.resource.data.notas))
          && request.resource.data.updatedAt == request.time
          && request.resource.data.updatedBy == me();

        // Itens só podem ser apagados junto com a exclusão de uma empresa arquivada.
        allow delete: if isStaff()
          && get(/databases/$(database)/documents/empresas/$(emp)).data.arquivada == true;
      }
    }

    // Acesso por empresa. O id do documento é "<empresaId>__<email em minúsculas>".
    match /membros/{id} {
      // Cada pessoa lê só os próprios vínculos; a equipe SAN lê todos.
      allow read: if signedIn() && (isStaff() || resource.data.email == me());

      allow create, update: if isStaff()
        && request.resource.data.keys().hasOnly(['empresaId', 'email', 'role', 'atualizadoEm', 'atualizadoPor'])
        && request.resource.data.keys().hasAll(['empresaId', 'email', 'role', 'atualizadoEm', 'atualizadoPor'])
        && request.resource.data.role == 'leitura'
        && request.resource.data.email is string
        && request.resource.data.email == request.resource.data.email.lower()
        && request.resource.data.empresaId is string
        && id == request.resource.data.empresaId + '__' + request.resource.data.email
        && exists(/databases/$(database)/documents/empresas/$(request.resource.data.empresaId))
        && request.resource.data.atualizadoEm == request.time
        && request.resource.data.atualizadoPor == me();

      allow delete: if isStaff();
    }

    // Todo o resto é negado.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
