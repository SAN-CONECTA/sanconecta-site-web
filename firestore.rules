rules_version = '2';

// Regras do Diagnóstico 360° de TI (SAN Conecta).
//
// Modelo:
//   staff/{email}                         administradores da SAN (todas as empresas)
//   empresas/{empresaId}                  dados da empresa cliente
//   empresas/{empresaId}/itens/{itemId}   respostas das perguntas, guardadas por item de origem ("1.1" a "10.2"), chaves q01..q40
//   empresas/{empresaId}/blocos/{codigo}  status, risco, nota 0 a 5, achados etc. de cada bloco das 3 rodadas (TI-01, AL-01, GE-01...)
//   empresas/{empresaId}/gemi/{codigo}    diagnóstico rápido GEMI (15 perguntas, 1.1 a 3.5); campo modo da empresa: completo ou rapido
//   empresas/{empresaId}/simulacao/atual  simulação de prejuízo por downtime (dados financeiros; equipe SAN grava; cliente só lê se liberado em membros.simulacao)
//   empresas/{empresaId}/log/{logId}      registro de cada gravação (quem, quando, o que mudou); só a equipe SAN lê
//   presenca/{email}                      último sinal de vida de cada pessoa (online agora, empresa e tela); só a equipe SAN lê
//   membros/{empresaId}__{email}          quem acessa cada empresa (role 'leitura' = cliente que preenche; 'visualizar' = somente consulta)
//
// Princípios:
//   - Tudo exige login com e-mail VERIFICADO. Criar conta sozinho não libera nenhum dado.
//   - Cliente só enxerga a empresa em que o e-mail dele consta em "membros".
//   - Só administradores SAN criam empresas, liberam usuários, preenchem os itens e alteram a equipe SAN.
//   - Cliente (membro da empresa) lê a própria empresa e pode gravar SÓ as respostas das perguntas e a situação da evidência
//     (v1.7) e, por bloco, a situação da evidência (v1.8). Nota de maturidade, risco, status, achados e recomendação continuam só da equipe SAN.
//   - Toda gravação em item ou bloco exige, no mesmo lote, um registro em log/ criado agora, com o e-mail de quem gravou (v1.7).
//     Registros não podem ser alterados; só somem junto com a exclusão da empresa arquivada.
//   - Empresas só são apagadas depois de arquivadas (e os itens delas junto); nunca por cliente.
//   - O primeiro administrador SAN é criado à mão no console (staff/<email>), conforme docs/DIAGNOSTICO.md.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email != null;
    }

    function me() {
      return request.auth.token.email.lower();
    }

    function isStaff() {
      return signedIn()
        && exists(/databases/$(database)/documents/staff/$(me()));
    }

    function isMember(emp) {
      return signedIn()
        && exists(/databases/$(database)/documents/membros/$(emp + '__' + me()));
    }

    // Cliente com perfil 'leitura' (preenche respostas) — 'visualizar' só consulta, não grava nada.
    function isEditor(emp) {
      return isMember(emp)
        && get(/databases/$(database)/documents/membros/$(emp + '__' + me())).data.role == 'leitura';
    }

    function itemIdOk(item) {
      return item.matches('^([1-5]\\.[1-5]|([6-9]|10)\\.[1-3])$');
    }

    // Códigos dos blocos: TI-01..TI-10 (com sufixo A a C), AL-01..AL-09 e GE-01..GE-09.
    function blocoIdOk(id) {
      return id == 'GEMI' || id == 'SIMULACAO' || id == 'DLP' || id.matches('^(TI-(0[1-9]|10)[A-C]?|AL-0[1-9]|GE-0[1-9])$');
    }

    // Exige, no mesmo lote da gravação, um registro novo no log feito por quem está gravando (uma única leitura).
    function logOk(emp) {
      let lg = getAfter(/databases/$(database)/documents/empresas/$(emp)/log/$(request.resource.data.logId)).data;
      return request.resource.data.logId is string
        && lg.email == me()
        && lg.quando == request.time;
    }

    function empAtiva(emp) {
      return get(/databases/$(database)/documents/empresas/$(emp)).data.arquivada != true;
    }

    function shortStr(v, max) {
      return v is string && v.size() <= max;
    }

    // Levantamento DLP (v1.22): respostas por seção em dlp/{s1..s7}. Chaves e tamanhos gerados de dlpDados.js.
    function dlpOpt(r, k, max) {
      return !(k in r) || shortStr(r[k], max);
    }

    function dlp_s1(r) {
      return r.keys().hasOnly(['id_empresa', 'id_data', 'id_part', 'id_resp', 'id_patroc', 'mo_motivo', 'mo_motivo_o', 'mo_motivo_v', 'mo_incid', 'mo_incid_o', 'mo_incid_v', 'mo_risco', 'mo_risco_o', 'mo_risco_v', 'mo_sucesso', 'mo_sucesso_o', 'mo_sucesso_v', 'mo_prazo', 'mo_prazo_o', 'mo_prazo_v', 'mo_invest', 'mo_invest_o', 'mo_invest_v', 'mo_prior', 'mo_prior_o', 'mo_prior_v'])
        && dlpOpt(r, 'id_empresa', 200)
        && dlpOpt(r, 'id_data', 200)
        && dlpOpt(r, 'id_part', 2000)
        && dlpOpt(r, 'id_resp', 200)
        && dlpOpt(r, 'id_patroc', 200)
        && dlpOpt(r, 'mo_motivo', 300)
        && dlpOpt(r, 'mo_motivo_o', 2000)
        && dlpOpt(r, 'mo_motivo_v', 1)
        && dlpOpt(r, 'mo_incid', 40)
        && dlpOpt(r, 'mo_incid_o', 2000)
        && dlpOpt(r, 'mo_incid_v', 1)
        && dlpOpt(r, 'mo_risco', 300)
        && dlpOpt(r, 'mo_risco_o', 2000)
        && dlpOpt(r, 'mo_risco_v', 1)
        && dlpOpt(r, 'mo_sucesso', 300)
        && dlpOpt(r, 'mo_sucesso_o', 2000)
        && dlpOpt(r, 'mo_sucesso_v', 1)
        && dlpOpt(r, 'mo_prazo', 40)
        && dlpOpt(r, 'mo_prazo_o', 2000)
        && dlpOpt(r, 'mo_prazo_v', 1)
        && dlpOpt(r, 'mo_invest', 40)
        && dlpOpt(r, 'mo_invest_o', 2000)
        && dlpOpt(r, 'mo_invest_v', 1)
        && dlpOpt(r, 'mo_prior', 40)
        && dlpOpt(r, 'mo_prior_o', 2000)
        && dlpOpt(r, 'mo_prior_v', 1);
    }

    function dlp_s2(r) {
      return r.keys().hasOnly(['da_cat', 'da_cat_v', 'da_pri', 'da_pri_v', 'da_outros', 'da_setores', 'da_setores_o', 'da_setores_v', 'da_onde', 'da_onde_o', 'da_onde_v', 'da_acesso', 'da_acesso_o', 'da_acesso_v', 'da_class', 'da_class_o', 'da_class_v', 'da_padroes', 'da_padroes_o', 'da_padroes_v', 'da_termos', 'da_formatos', 'da_formatos_o', 'da_formatos_v'])
        && dlpOpt(r, 'da_cat', 300)
        && dlpOpt(r, 'da_cat_v', 1)
        && dlpOpt(r, 'da_pri', 300)
        && dlpOpt(r, 'da_pri_v', 1)
        && dlpOpt(r, 'da_outros', 200)
        && dlpOpt(r, 'da_setores', 300)
        && dlpOpt(r, 'da_setores_o', 2000)
        && dlpOpt(r, 'da_setores_v', 1)
        && dlpOpt(r, 'da_onde', 300)
        && dlpOpt(r, 'da_onde_o', 2000)
        && dlpOpt(r, 'da_onde_v', 1)
        && dlpOpt(r, 'da_acesso', 40)
        && dlpOpt(r, 'da_acesso_o', 2000)
        && dlpOpt(r, 'da_acesso_v', 1)
        && dlpOpt(r, 'da_class', 40)
        && dlpOpt(r, 'da_class_o', 2000)
        && dlpOpt(r, 'da_class_v', 1)
        && dlpOpt(r, 'da_padroes', 300)
        && dlpOpt(r, 'da_padroes_o', 2000)
        && dlpOpt(r, 'da_padroes_v', 1)
        && dlpOpt(r, 'da_termos', 2000)
        && dlpOpt(r, 'da_formatos', 300)
        && dlpOpt(r, 'da_formatos_o', 2000)
        && dlpOpt(r, 'da_formatos_v', 1);
    }

    function dlp_s3(r) {
      return r.keys().hasOnly(['ca_email_u', 'ca_email_p', 'ca_email_r', 'ca_email_v', 'ca_gmail_u', 'ca_gmail_p', 'ca_gmail_r', 'ca_gmail_v', 'ca_webmail_u', 'ca_webmail_p', 'ca_webmail_r', 'ca_webmail_v', 'ca_nuvem_u', 'ca_nuvem_p', 'ca_nuvem_r', 'ca_nuvem_v', 'ca_gdrive_u', 'ca_gdrive_p', 'ca_gdrive_r', 'ca_gdrive_v', 'ca_pessoal_u', 'ca_pessoal_p', 'ca_pessoal_r', 'ca_pessoal_v', 'ca_usb_u', 'ca_usb_p', 'ca_usb_r', 'ca_usb_v', 'ca_impr_u', 'ca_impr_p', 'ca_impr_r', 'ca_impr_v', 'ca_ia_u', 'ca_ia_p', 'ca_ia_r', 'ca_ia_v', 'ca_msg_u', 'ca_msg_p', 'ca_msg_r', 'ca_msg_v', 'ca_tela_u', 'ca_tela_p', 'ca_tela_r', 'ca_tela_v', 'ca_ia_quais', 'ca_ia_quais_o', 'ca_ia_quais_v', 'ca_legit', 'ca_legit_o', 'ca_legit_v', 'ca_parc', 'ca_parc_o', 'ca_parc_v', 'ca_exc', 'ca_exc_o', 'ca_exc_v', 'ca_fluxos'])
        && dlpOpt(r, 'ca_email_u', 40)
        && dlpOpt(r, 'ca_email_p', 20)
        && dlpOpt(r, 'ca_email_r', 2000)
        && dlpOpt(r, 'ca_email_v', 1)
        && dlpOpt(r, 'ca_gmail_u', 40)
        && dlpOpt(r, 'ca_gmail_p', 20)
        && dlpOpt(r, 'ca_gmail_r', 2000)
        && dlpOpt(r, 'ca_gmail_v', 1)
        && dlpOpt(r, 'ca_webmail_u', 40)
        && dlpOpt(r, 'ca_webmail_p', 20)
        && dlpOpt(r, 'ca_webmail_r', 2000)
        && dlpOpt(r, 'ca_webmail_v', 1)
        && dlpOpt(r, 'ca_nuvem_u', 40)
        && dlpOpt(r, 'ca_nuvem_p', 20)
        && dlpOpt(r, 'ca_nuvem_r', 2000)
        && dlpOpt(r, 'ca_nuvem_v', 1)
        && dlpOpt(r, 'ca_gdrive_u', 40)
        && dlpOpt(r, 'ca_gdrive_p', 20)
        && dlpOpt(r, 'ca_gdrive_r', 2000)
        && dlpOpt(r, 'ca_gdrive_v', 1)
        && dlpOpt(r, 'ca_pessoal_u', 40)
        && dlpOpt(r, 'ca_pessoal_p', 20)
        && dlpOpt(r, 'ca_pessoal_r', 2000)
        && dlpOpt(r, 'ca_pessoal_v', 1)
        && dlpOpt(r, 'ca_usb_u', 40)
        && dlpOpt(r, 'ca_usb_p', 20)
        && dlpOpt(r, 'ca_usb_r', 2000)
        && dlpOpt(r, 'ca_usb_v', 1)
        && dlpOpt(r, 'ca_impr_u', 40)
        && dlpOpt(r, 'ca_impr_p', 20)
        && dlpOpt(r, 'ca_impr_r', 2000)
        && dlpOpt(r, 'ca_impr_v', 1)
        && dlpOpt(r, 'ca_ia_u', 40)
        && dlpOpt(r, 'ca_ia_p', 20)
        && dlpOpt(r, 'ca_ia_r', 2000)
        && dlpOpt(r, 'ca_ia_v', 1)
        && dlpOpt(r, 'ca_msg_u', 40)
        && dlpOpt(r, 'ca_msg_p', 20)
        && dlpOpt(r, 'ca_msg_r', 2000)
        && dlpOpt(r, 'ca_msg_v', 1)
        && dlpOpt(r, 'ca_tela_u', 40)
        && dlpOpt(r, 'ca_tela_p', 20)
        && dlpOpt(r, 'ca_tela_r', 2000)
        && dlpOpt(r, 'ca_tela_v', 1)
        && dlpOpt(r, 'ca_ia_quais', 300)
        && dlpOpt(r, 'ca_ia_quais_o', 2000)
        && dlpOpt(r, 'ca_ia_quais_v', 1)
        && dlpOpt(r, 'ca_legit', 40)
        && dlpOpt(r, 'ca_legit_o', 2000)
        && dlpOpt(r, 'ca_legit_v', 1)
        && dlpOpt(r, 'ca_parc', 300)
        && dlpOpt(r, 'ca_parc_o', 2000)
        && dlpOpt(r, 'ca_parc_v', 1)
        && dlpOpt(r, 'ca_exc', 40)
        && dlpOpt(r, 'ca_exc_o', 2000)
        && dlpOpt(r, 'ca_exc_v', 1)
        && dlpOpt(r, 'ca_fluxos', 2000);
    }

    function dlp_s4(r) {
      return r.keys().hasOnly(['am_plat', 'am_plat_v', 'am_outra', 'am_sist', 'am_sist_o', 'am_sist_v', 'am_plano', 'am_plano_o', 'am_plano_v', 'am_usuarios', 'am_usuarios_o', 'am_usuarios_v', 'am_so', 'am_so_o', 'am_so_v', 'am_equip', 'am_equip_o', 'am_equip_v', 'am_remoto', 'am_remoto_o', 'am_remoto_v', 'am_serv', 'am_serv_o', 'am_serv_v', 'am_dir', 'am_dir_o', 'am_dir_v', 'am_agentes', 'am_agentes_o', 'am_agentes_v', 'am_seg', 'am_seg_o', 'am_seg_v', 'am_autoriza', 'am_autoriza_o', 'am_autoriza_v', 'am_nav', 'am_nav_o', 'am_nav_v', 'am_integra', 'am_integra_o', 'am_integra_v', 'am_registro'])
        && dlpOpt(r, 'am_plat', 300)
        && dlpOpt(r, 'am_plat_v', 1)
        && dlpOpt(r, 'am_outra', 200)
        && dlpOpt(r, 'am_sist', 300)
        && dlpOpt(r, 'am_sist_o', 2000)
        && dlpOpt(r, 'am_sist_v', 1)
        && dlpOpt(r, 'am_plano', 300)
        && dlpOpt(r, 'am_plano_o', 2000)
        && dlpOpt(r, 'am_plano_v', 1)
        && dlpOpt(r, 'am_usuarios', 40)
        && dlpOpt(r, 'am_usuarios_o', 2000)
        && dlpOpt(r, 'am_usuarios_v', 1)
        && dlpOpt(r, 'am_so', 300)
        && dlpOpt(r, 'am_so_o', 2000)
        && dlpOpt(r, 'am_so_v', 1)
        && dlpOpt(r, 'am_equip', 300)
        && dlpOpt(r, 'am_equip_o', 2000)
        && dlpOpt(r, 'am_equip_v', 1)
        && dlpOpt(r, 'am_remoto', 40)
        && dlpOpt(r, 'am_remoto_o', 2000)
        && dlpOpt(r, 'am_remoto_v', 1)
        && dlpOpt(r, 'am_serv', 300)
        && dlpOpt(r, 'am_serv_o', 2000)
        && dlpOpt(r, 'am_serv_v', 1)
        && dlpOpt(r, 'am_dir', 300)
        && dlpOpt(r, 'am_dir_o', 2000)
        && dlpOpt(r, 'am_dir_v', 1)
        && dlpOpt(r, 'am_agentes', 300)
        && dlpOpt(r, 'am_agentes_o', 2000)
        && dlpOpt(r, 'am_agentes_v', 1)
        && dlpOpt(r, 'am_seg', 300)
        && dlpOpt(r, 'am_seg_o', 2000)
        && dlpOpt(r, 'am_seg_v', 1)
        && dlpOpt(r, 'am_autoriza', 300)
        && dlpOpt(r, 'am_autoriza_o', 2000)
        && dlpOpt(r, 'am_autoriza_v', 1)
        && dlpOpt(r, 'am_nav', 300)
        && dlpOpt(r, 'am_nav_o', 2000)
        && dlpOpt(r, 'am_nav_v', 1)
        && dlpOpt(r, 'am_integra', 300)
        && dlpOpt(r, 'am_integra_o', 2000)
        && dlpOpt(r, 'am_integra_v', 1)
        && dlpOpt(r, 'am_registro', 2000);
    }

    function dlp_s5(r) {
      return r.keys().hasOnly(['po_modo', 'po_modo_o', 'po_modo_v', 'po_bloq', 'po_bloq_o', 'po_bloq_v', 'po_justif', 'po_justif_o', 'po_justif_v', 'po_quem', 'po_quem_o', 'po_quem_v', 'po_prazo', 'po_prazo_o', 'po_prazo_v', 'po_falsos', 'po_falsos_o', 'po_falsos_v', 'po_relat', 'po_relat_o', 'po_relat_v'])
        && dlpOpt(r, 'po_modo', 40)
        && dlpOpt(r, 'po_modo_o', 2000)
        && dlpOpt(r, 'po_modo_v', 1)
        && dlpOpt(r, 'po_bloq', 300)
        && dlpOpt(r, 'po_bloq_o', 2000)
        && dlpOpt(r, 'po_bloq_v', 1)
        && dlpOpt(r, 'po_justif', 40)
        && dlpOpt(r, 'po_justif_o', 2000)
        && dlpOpt(r, 'po_justif_v', 1)
        && dlpOpt(r, 'po_quem', 300)
        && dlpOpt(r, 'po_quem_o', 2000)
        && dlpOpt(r, 'po_quem_v', 1)
        && dlpOpt(r, 'po_prazo', 40)
        && dlpOpt(r, 'po_prazo_o', 2000)
        && dlpOpt(r, 'po_prazo_v', 1)
        && dlpOpt(r, 'po_falsos', 40)
        && dlpOpt(r, 'po_falsos_o', 2000)
        && dlpOpt(r, 'po_falsos_v', 1)
        && dlpOpt(r, 'po_relat', 300)
        && dlpOpt(r, 'po_relat_o', 2000)
        && dlpOpt(r, 'po_relat_v', 1);
    }

    function dlp_s6(r) {
      return r.keys().hasOnly(['re_patroc', 're_gestores', 're_gestores_o', 're_gestores_v', 're_comunica', 're_comunica_o', 're_comunica_v', 're_politica', 're_politica_o', 're_politica_v', 're_admin', 're_admin_o', 're_admin_v', 're_retencao', 're_retencao_o', 're_retencao_v', 're_saida', 're_saida_o', 're_saida_v', 're_definidos'])
        && dlpOpt(r, 're_patroc', 200)
        && dlpOpt(r, 're_gestores', 300)
        && dlpOpt(r, 're_gestores_o', 2000)
        && dlpOpt(r, 're_gestores_v', 1)
        && dlpOpt(r, 're_comunica', 300)
        && dlpOpt(r, 're_comunica_o', 2000)
        && dlpOpt(r, 're_comunica_v', 1)
        && dlpOpt(r, 're_politica', 40)
        && dlpOpt(r, 're_politica_o', 2000)
        && dlpOpt(r, 're_politica_v', 1)
        && dlpOpt(r, 're_admin', 300)
        && dlpOpt(r, 're_admin_o', 2000)
        && dlpOpt(r, 're_admin_v', 1)
        && dlpOpt(r, 're_retencao', 40)
        && dlpOpt(r, 're_retencao_o', 2000)
        && dlpOpt(r, 're_retencao_v', 1)
        && dlpOpt(r, 're_saida', 40)
        && dlpOpt(r, 're_saida_o', 2000)
        && dlpOpt(r, 're_saida_v', 1)
        && dlpOpt(r, 're_definidos', 2000);
    }

    function dlp_s7(r) {
      return r.keys().hasOnly(['pi_piloto', 'pi_piloto_o', 'pi_piloto_v', 'pi_criterios', 'pi_criterios_o', 'pi_criterios_v', 'pe1_resp', 'pe1_prazo', 'pe2_resp', 'pe2_prazo', 'pe3_resp', 'pe3_prazo', 'pe4_resp', 'pe4_prazo', 'pi_resumo', 'pi_fora', 'pi_proxima'])
        && dlpOpt(r, 'pi_piloto', 300)
        && dlpOpt(r, 'pi_piloto_o', 2000)
        && dlpOpt(r, 'pi_piloto_v', 1)
        && dlpOpt(r, 'pi_criterios', 300)
        && dlpOpt(r, 'pi_criterios_o', 2000)
        && dlpOpt(r, 'pi_criterios_v', 1)
        && dlpOpt(r, 'pe1_resp', 200)
        && dlpOpt(r, 'pe1_prazo', 200)
        && dlpOpt(r, 'pe2_resp', 200)
        && dlpOpt(r, 'pe2_prazo', 200)
        && dlpOpt(r, 'pe3_resp', 200)
        && dlpOpt(r, 'pe3_prazo', 200)
        && dlpOpt(r, 'pe4_resp', 200)
        && dlpOpt(r, 'pe4_prazo', 200)
        && dlpOpt(r, 'pi_resumo', 2000)
        && dlpOpt(r, 'pi_fora', 2000)
        && dlpOpt(r, 'pi_proxima', 200);
    }

    function dlpOk(sid, r) {
      return r is map
        && ((sid == 's1' && dlp_s1(r))
            || (sid == 's2' && dlp_s2(r))
            || (sid == 's3' && dlp_s3(r))
            || (sid == 's4' && dlp_s4(r))
            || (sid == 's5' && dlp_s5(r))
            || (sid == 's6' && dlp_s6(r))
            || (sid == 's7' && dlp_s7(r)));
    }

    // Respostas por pergunta (v1.6): chaves fixas q01..q40, texto até 2000. Notas de maturidade por bloco: chaves b1..b10, inteiro 0 a 5.
    function respOk(r) {
      return r is map
        && r.keys().hasOnly(['q01','q02','q03','q04','q05','q06','q07','q08','q09','q10','q11','q12','q13','q14','q15','q16','q17','q18','q19','q20','q21','q22','q23','q24','q25','q26','q27','q28','q29','q30','q31','q32','q33','q34','q35','q36','q37','q38','q39','q40'])
        && (!('q01' in r) || shortStr(r['q01'], 2000))
        && (!('q02' in r) || shortStr(r['q02'], 2000))
        && (!('q03' in r) || shortStr(r['q03'], 2000))
        && (!('q04' in r) || shortStr(r['q04'], 2000))
        && (!('q05' in r) || shortStr(r['q05'], 2000))
        && (!('q06' in r) || shortStr(r['q06'], 2000))
        && (!('q07' in r) || shortStr(r['q07'], 2000))
        && (!('q08' in r) || shortStr(r['q08'], 2000))
        && (!('q09' in r) || shortStr(r['q09'], 2000))
        && (!('q10' in r) || shortStr(r['q10'], 2000))
        && (!('q11' in r) || shortStr(r['q11'], 2000))
        && (!('q12' in r) || shortStr(r['q12'], 2000))
        && (!('q13' in r) || shortStr(r['q13'], 2000))
        && (!('q14' in r) || shortStr(r['q14'], 2000))
        && (!('q15' in r) || shortStr(r['q15'], 2000))
        && (!('q16' in r) || shortStr(r['q16'], 2000))
        && (!('q17' in r) || shortStr(r['q17'], 2000))
        && (!('q18' in r) || shortStr(r['q18'], 2000))
        && (!('q19' in r) || shortStr(r['q19'], 2000))
        && (!('q20' in r) || shortStr(r['q20'], 2000))
        && (!('q21' in r) || shortStr(r['q21'], 2000))
        && (!('q22' in r) || shortStr(r['q22'], 2000))
        && (!('q23' in r) || shortStr(r['q23'], 2000))
        && (!('q24' in r) || shortStr(r['q24'], 2000))
        && (!('q25' in r) || shortStr(r['q25'], 2000))
        && (!('q26' in r) || shortStr(r['q26'], 2000))
        && (!('q27' in r) || shortStr(r['q27'], 2000))
        && (!('q28' in r) || shortStr(r['q28'], 2000))
        && (!('q29' in r) || shortStr(r['q29'], 2000))
        && (!('q30' in r) || shortStr(r['q30'], 2000))
        && (!('q31' in r) || shortStr(r['q31'], 2000))
        && (!('q32' in r) || shortStr(r['q32'], 2000))
        && (!('q33' in r) || shortStr(r['q33'], 2000))
        && (!('q34' in r) || shortStr(r['q34'], 2000))
        && (!('q35' in r) || shortStr(r['q35'], 2000))
        && (!('q36' in r) || shortStr(r['q36'], 2000))
        && (!('q37' in r) || shortStr(r['q37'], 2000))
        && (!('q38' in r) || shortStr(r['q38'], 2000))
        && (!('q39' in r) || shortStr(r['q39'], 2000))
        && (!('q40' in r) || shortStr(r['q40'], 2000));
    }

    // Equipe SAN
    match /staff/{email} {
      allow read: if signedIn() && (isStaff() || email == me());
      allow create: if isStaff()
        && email == email.lower()
        && request.resource.data.keys().hasOnly(['email', 'criadoEm', 'criadoPor'])
        && request.resource.data.email == email
        && request.resource.data.criadoPor == me()
        && request.resource.data.criadoEm == request.time;
      allow delete: if isStaff() && email != me();
      allow update: if false;
    }

    // Empresas clientes
    match /empresas/{emp} {
      allow read: if isStaff() || isMember(emp);

      allow create: if isStaff()
        && request.resource.data.keys().hasOnly(['nome', 'cnpj', 'responsavel', 'inicio', 'prazo', 'modo', 'arquivada', 'criadoEm', 'criadoPor'])
        && request.resource.data.keys().hasAll(['nome', 'criadoEm', 'criadoPor'])
        && shortStr(request.resource.data.nome, 120) && request.resource.data.nome.size() >= 2
        && shortStr(request.resource.data.cnpj, 20)
        && shortStr(request.resource.data.responsavel, 120)
        && shortStr(request.resource.data.inicio, 10)
        && shortStr(request.resource.data.prazo, 10)
        && request.resource.data.arquivada is bool
        && (!('modo' in request.resource.data) || request.resource.data.modo in ['completo', 'rapido'])
        && request.resource.data.criadoEm == request.time
        && request.resource.data.criadoPor == me();

      allow update: if isStaff()
        && request.resource.data.keys().hasOnly(['nome', 'cnpj', 'responsavel', 'inicio', 'prazo', 'modo', 'arquivada', 'criadoEm', 'criadoPor', 'atualizadoEm', 'atualizadoPor'])
        && shortStr(request.resource.data.nome, 120) && request.resource.data.nome.size() >= 2
        && shortStr(request.resource.data.cnpj, 20)
        && shortStr(request.resource.data.responsavel, 120)
        && shortStr(request.resource.data.inicio, 10)
        && shortStr(request.resource.data.prazo, 10)
        && request.resource.data.arquivada is bool
        && (!('modo' in request.resource.data) || request.resource.data.modo in ['completo', 'rapido'])
        && request.resource.data.criadoEm == resource.data.criadoEm
        && request.resource.data.criadoPor == resource.data.criadoPor
        && request.resource.data.atualizadoEm == request.time
        && request.resource.data.atualizadoPor == me();

      // Só se apaga empresa que já foi arquivada (o primeiro passo é sempre arquivar).
      allow delete: if isStaff() && resource.data.arquivada == true;

      // Respostas das perguntas, por item de origem. Equipe SAN, ou cliente da empresa se ela não estiver arquivada.
      match /itens/{item} {
        allow read: if isStaff() || isMember(emp);

        allow create: if (isStaff() || (isEditor(emp) && empAtiva(emp)))
          && itemIdOk(item)
          && request.resource.data.keys().hasOnly(['respostas', 'updatedAt', 'updatedBy', 'logId'])
          && request.resource.data.keys().hasAll(['respostas', 'updatedAt', 'updatedBy', 'logId'])
          && respOk(request.resource.data.respostas)
          && request.resource.data.updatedAt == request.time
          && request.resource.data.updatedBy == me()
          && logOk(emp);

        allow update: if (isStaff() || (isEditor(emp) && empAtiva(emp)))
          && itemIdOk(item)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['respostas', 'updatedAt', 'updatedBy', 'logId'])
          && respOk(request.resource.data.respostas)
          && request.resource.data.updatedAt == request.time
          && request.resource.data.updatedBy == me()
          && logOk(emp);

        // Itens só podem ser apagados junto com a exclusão de uma empresa arquivada.
        allow delete: if isStaff()
          && get(/databases/$(database)/documents/empresas/$(emp)).data.arquivada == true;
      }

      // Blocos das três rodadas. Equipe SAN grava tudo; cliente grava só a situação da evidência.
      match /blocos/{bid} {
        allow read: if isStaff() || isMember(emp);

        allow create, update: if isStaff()
          && blocoIdOk(bid)
          && request.resource.data.keys().hasOnly(['status', 'risk', 'owner', 'due', 'findings', 'evidence', 'reco', 'nota', 'evidStatus', 'updatedAt', 'updatedBy', 'logId'])
          && request.resource.data.keys().hasAll(['status', 'risk', 'owner', 'due', 'findings', 'evidence', 'reco', 'nota', 'evidStatus', 'updatedAt', 'updatedBy', 'logId'])
          && request.resource.data.status in ['nao_iniciado', 'coleta', 'analise', 'concluido']
          && request.resource.data.risk in ['sem', 'baixo', 'medio', 'alto', 'critico']
          && shortStr(request.resource.data.owner, 80)
          && shortStr(request.resource.data.due, 10)
          && shortStr(request.resource.data.findings, 4000)
          && shortStr(request.resource.data.evidence, 300)
          && shortStr(request.resource.data.reco, 4000)
          && (request.resource.data.nota == null
              || (request.resource.data.nota is int && request.resource.data.nota >= 0 && request.resource.data.nota <= 5))
          && request.resource.data.evidStatus in ['nao_solicitada', 'solicitada', 'parcial', 'recebida', 'nao_recebida', 'nao_aplica']
          && request.resource.data.updatedAt == request.time
          && request.resource.data.updatedBy == me()
          && logOk(emp);

        allow create: if isEditor(emp) && empAtiva(emp)
          && blocoIdOk(bid)
          && request.resource.data.keys().hasOnly(['evidStatus', 'updatedAt', 'updatedBy', 'logId'])
          && request.resource.data.keys().hasAll(['evidStatus', 'updatedAt', 'updatedBy', 'logId'])
          && request.resource.data.evidStatus in ['nao_solicitada', 'solicitada', 'parcial', 'recebida', 'nao_recebida', 'nao_aplica']
          && request.resource.data.updatedAt == request.time
          && request.resource.data.updatedBy == me()
          && logOk(emp);

        allow update: if isEditor(emp) && empAtiva(emp)
          && blocoIdOk(bid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['evidStatus', 'updatedAt', 'updatedBy', 'logId'])
          && request.resource.data.evidStatus in ['nao_solicitada', 'solicitada', 'parcial', 'recebida', 'nao_recebida', 'nao_aplica']
          && request.resource.data.updatedAt == request.time
          && request.resource.data.updatedBy == me()
          && logOk(emp);

        allow delete: if isStaff()
          && get(/databases/$(database)/documents/empresas/$(emp)).data.arquivada == true;
      }

      // Diagnóstico rápido GEMI (v1.9): 15 perguntas (1.1 a 3.5). Só a equipe SAN grava; o cliente lê.
      match /gemi/{qid} {
        allow read: if isStaff() || isMember(emp);

        allow create, update: if isStaff()
          && qid.matches('^[1-3]\\.[1-5]$')
          && request.resource.data.keys().hasOnly(['nota', 'obs', 'texto', 'opcoes', 'updatedAt', 'updatedBy', 'logId'])
          && request.resource.data.keys().hasAll(['updatedAt', 'updatedBy', 'logId'])
          && (!('nota' in request.resource.data)
              || request.resource.data.nota == null
              || (request.resource.data.nota is int && request.resource.data.nota >= 0 && request.resource.data.nota <= 4))
          && (!('obs' in request.resource.data) || shortStr(request.resource.data.obs, 2000))
          && (!('texto' in request.resource.data) || shortStr(request.resource.data.texto, 4000))
          && (!('opcoes' in request.resource.data)
              || (request.resource.data.opcoes is list && request.resource.data.opcoes.size() <= 9
                  && request.resource.data.opcoes.hasOnly(['servidor', 'nobreak', 'link', 'outros', 'erp', 'integracao', 'infra', 'seguranca', 'dependencia'])))
          && request.resource.data.updatedAt == request.time
          && request.resource.data.updatedBy == me()
          && logOk(emp);

        // v1.12: cliente com perfil 'leitura' marca a nota e escreve as dissertativas; não mexe na observação do consultor.
        allow create: if isEditor(emp) && empAtiva(emp)
          && qid.matches('^[1-3]\\.[1-5]$')
          && request.resource.data.keys().hasOnly(['nota', 'texto', 'opcoes', 'updatedAt', 'updatedBy', 'logId'])
          && request.resource.data.keys().hasAll(['updatedAt', 'updatedBy', 'logId'])
          && (!('nota' in request.resource.data)
              || request.resource.data.nota == null
              || (request.resource.data.nota is int && request.resource.data.nota >= 0 && request.resource.data.nota <= 4))
          && (!('texto' in request.resource.data) || shortStr(request.resource.data.texto, 4000))
          && (!('opcoes' in request.resource.data)
              || (request.resource.data.opcoes is list && request.resource.data.opcoes.size() <= 9
                  && request.resource.data.opcoes.hasOnly(['servidor', 'nobreak', 'link', 'outros', 'erp', 'integracao', 'infra', 'seguranca', 'dependencia'])))
          && request.resource.data.updatedAt == request.time
          && request.resource.data.updatedBy == me()
          && logOk(emp);

        allow update: if isEditor(emp) && empAtiva(emp)
          && qid.matches('^[1-3]\\.[1-5]$')
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nota', 'texto', 'opcoes', 'updatedAt', 'updatedBy', 'logId'])
          && request.resource.data.keys().hasAll(['updatedAt', 'updatedBy', 'logId'])
          && (!('nota' in request.resource.data)
              || request.resource.data.nota == null
              || (request.resource.data.nota is int && request.resource.data.nota >= 0 && request.resource.data.nota <= 4))
          && (!('texto' in request.resource.data) || shortStr(request.resource.data.texto, 4000))
          && (!('opcoes' in request.resource.data)
              || (request.resource.data.opcoes is list && request.resource.data.opcoes.size() <= 9
                  && request.resource.data.opcoes.hasOnly(['servidor', 'nobreak', 'link', 'outros', 'erp', 'integracao', 'infra', 'seguranca', 'dependencia'])))
          && request.resource.data.updatedAt == request.time
          && request.resource.data.updatedBy == me()
          && logOk(emp);

        allow delete: if isStaff()
          && get(/databases/$(database)/documents/empresas/$(emp)).data.arquivada == true;
      }

      // Levantamento DLP (v1.22): SAN e cliente (perfil 'leitura') preenchem o mesmo levantamento, uma seção por documento (s1..s7).
      // As observações internas ficam num documento à parte ('notas'), que só a equipe SAN lê e grava (regra não filtra campos).
      match /dlp/{sid} {
        allow read: if isStaff() || (sid != 'notas' && isMember(emp));

        allow create, update: if (isStaff() || (isEditor(emp) && empAtiva(emp)))
          && request.resource.data.keys().hasOnly(['r', 'updatedAt', 'updatedBy', 'logId'])
          && request.resource.data.keys().hasAll(['r', 'updatedAt', 'updatedBy', 'logId'])
          && dlpOk(sid, request.resource.data.r)
          && request.resource.data.updatedAt == request.time
          && request.resource.data.updatedBy == me()
          && logOk(emp);

        allow create, update: if isStaff()
          && sid == 'notas'
          && request.resource.data.keys().hasOnly(['n', 'updatedAt', 'updatedBy', 'logId'])
          && request.resource.data.keys().hasAll(['n', 'updatedAt', 'updatedBy', 'logId'])
          && request.resource.data.n is map
          && request.resource.data.n.keys().hasOnly(['s1', 's2', 's3', 's4', 's5', 's6', 's7'])
          && (!('s1' in request.resource.data.n) || shortStr(request.resource.data.n.s1, 4000))
          && (!('s2' in request.resource.data.n) || shortStr(request.resource.data.n.s2, 4000))
          && (!('s3' in request.resource.data.n) || shortStr(request.resource.data.n.s3, 4000))
          && (!('s4' in request.resource.data.n) || shortStr(request.resource.data.n.s4, 4000))
          && (!('s5' in request.resource.data.n) || shortStr(request.resource.data.n.s5, 4000))
          && (!('s6' in request.resource.data.n) || shortStr(request.resource.data.n.s6, 4000))
          && (!('s7' in request.resource.data.n) || shortStr(request.resource.data.n.s7, 4000))
          && request.resource.data.updatedAt == request.time
          && request.resource.data.updatedBy == me()
          && logOk(emp);

        allow delete: if isStaff()
          && get(/databases/$(database)/documents/empresas/$(emp)).data.arquivada == true;
      }

      // Simulação de prejuízo por indisponibilidade de TI (v1.10): um único documento "atual". Só a equipe SAN lê e grava,
      // porque guarda dados financeiros do cliente. Percentual da operação afetada em fração (0 a 1).
      match /simulacao/{sid} {
        // v1.13: cliente só lê se a equipe SAN marcou 'simulacao' no vínculo dele (membros); gravar continua só da equipe.
        allow read: if isStaff()
          || (isMember(emp)
              && get(/databases/$(database)/documents/membros/$(emp + '__' + me())).data.get('simulacao', false) == true);

        allow create, update: if isStaff()
          && sid == 'atual'
          && request.resource.data.keys().hasOnly(['fat', 'dias', 'horas', 'colab', 'custo', 'pct', 'emerg', 'rto', 'invest', 'updatedAt', 'updatedBy', 'logId'])
          && request.resource.data.keys().hasAll(['fat', 'dias', 'horas', 'colab', 'custo', 'pct', 'emerg', 'rto', 'invest', 'updatedAt', 'updatedBy', 'logId'])
          && request.resource.data.fat is number && request.resource.data.fat >= 0 && request.resource.data.fat <= 10000000000
          && request.resource.data.dias is number && request.resource.data.dias >= 1 && request.resource.data.dias <= 31
          && request.resource.data.horas is number && request.resource.data.horas >= 1 && request.resource.data.horas <= 24
          && request.resource.data.colab is number && request.resource.data.colab >= 0 && request.resource.data.colab <= 1000000
          && request.resource.data.custo is number && request.resource.data.custo >= 0 && request.resource.data.custo <= 10000000
          && request.resource.data.pct is number && request.resource.data.pct >= 0 && request.resource.data.pct <= 1
          && request.resource.data.emerg is number && request.resource.data.emerg >= 0 && request.resource.data.emerg <= 1000000000
          && request.resource.data.rto is number && request.resource.data.rto >= 0 && request.resource.data.rto <= 8760
          && request.resource.data.invest is number && request.resource.data.invest >= 0 && request.resource.data.invest <= 1000000000
          && request.resource.data.updatedAt == request.time
          && request.resource.data.updatedBy == me()
          && logOk(emp);

        allow delete: if isStaff()
          && get(/databases/$(database)/documents/empresas/$(emp)).data.arquivada == true;
      }

      // Log de rastreio (v1.7): criado junto com cada gravação de item; imutável; só a equipe SAN lê.
      match /log/{lid} {
        allow read: if isStaff();

        allow create: if (isStaff() || isEditor(emp))
          && request.resource.data.keys().hasOnly(['item', 'email', 'papel', 'quando', 'mudancas'])
          && request.resource.data.keys().hasAll(['item', 'email', 'papel', 'quando', 'mudancas'])
          && request.resource.data.item is string
          && blocoIdOk(request.resource.data.item)
          && request.resource.data.email == me()
          && request.resource.data.papel in ['equipe', 'cliente']
          && (request.resource.data.papel == 'equipe') == isStaff()
          && request.resource.data.quando == request.time
          && request.resource.data.mudancas is list
          && request.resource.data.mudancas.size() >= 1
          && request.resource.data.mudancas.size() <= 120;

        allow update: if false;

        allow delete: if isStaff()
          && get(/databases/$(database)/documents/empresas/$(emp)).data.arquivada == true;
      }
    }

    // Acesso por empresa. O id do documento é "<empresaId>__<email em minúsculas>".
    match /membros/{id} {
      // Cada pessoa lê só os próprios vínculos; a equipe SAN lê todos.
      allow read: if signedIn() && (isStaff() || resource.data.email == me());

      allow create, update: if isStaff()
        && request.resource.data.keys().hasOnly(['empresaId', 'email', 'role', 'simulacao', 'atualizadoEm', 'atualizadoPor'])
        && request.resource.data.keys().hasAll(['empresaId', 'email', 'role', 'atualizadoEm', 'atualizadoPor'])
        && (!('simulacao' in request.resource.data) || request.resource.data.simulacao is bool)
        && request.resource.data.role in ['leitura', 'visualizar']
        && request.resource.data.email is string
        && request.resource.data.email == request.resource.data.email.lower()
        && request.resource.data.empresaId is string
        && id == request.resource.data.empresaId + '__' + request.resource.data.email
        && exists(/databases/$(database)/documents/empresas/$(request.resource.data.empresaId))
        && request.resource.data.atualizadoEm == request.time
        && request.resource.data.atualizadoPor == me();

      allow delete: if isStaff();
    }

    // Presença (v1.18): cada pessoa grava só o próprio documento (sinal de vida a cada minuto); só a equipe SAN lê.
    match /presenca/{id} {
      allow read: if isStaff();

      allow create, update: if signedIn()
        && id == me()
        && request.resource.data.keys().hasOnly(['email', 'nome', 'empresaId', 'tela', 'visto', 'criada'])
        && request.resource.data.keys().hasAll(['email', 'visto'])
        && request.resource.data.email == me()
        && request.resource.data.visto == request.time
        && (!('criada' in request.resource.data)
            || (request.resource.data.criada is number && request.resource.data.criada > 0
                && request.resource.data.criada <= request.time.toMillis() + 60000))
        && (!('nome' in request.resource.data) || shortStr(request.resource.data.nome, 120))
        && (!('empresaId' in request.resource.data) || shortStr(request.resource.data.empresaId, 80))
        && (!('tela' in request.resource.data) || shortStr(request.resource.data.tela, 30));

      allow delete: if isStaff();
    }

    // Todo o resto é negado.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
